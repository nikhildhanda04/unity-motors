generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the URL lives in prisma.config.ts, not here.
}

model Car {
  id             String   @id @default(uuid())
  slug           String   @unique
  title          String
  price          Int      @default(0)
  priceOnRequest Boolean  @default(false)
  year           Int      @default(0)
  kmDriven       Int      @default(0)
  fuelType       String   @default("")
  transmission   String   @default("")
  ownership      String   @default("")
  // The RTO state a car is registered in — it decides transfer paperwork and
  // road tax, so buyers filter on it.
  stateRegistered String  @default("")
  // Defaults true: the workshop arranges finance on everything unless told
  // otherwise, so the admin checkbox starts ticked.
  loanAvailable  Boolean  @default(true)
  description    String   @default("")
  features       String[]
  images         Json     @default("[]")
  video          Json?
  sold           Boolean  @default(false)
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())

  // Listings are always "unsold first, newest first".
  @@index([sold, createdAt])
  @@map("cars")
}

/// Parts and accessories sold from /store. Deliberately thinner than Car:
/// no year/km/registration, and stock is a boolean because the sale closes on
/// WhatsApp, where any unit count would drift out of sync within a week.
model Product {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  /// Base price. Ignored when variants exist — each variant carries its own,
  /// and listings read "from <lowest>".
  price       Int      @default(0)
  category    String   @default("")
  description String   @default("")
  /// [{ name, price }] — empty for a product sold one way only.
  variants    Json     @default("[]")
  images      Json     @default("[]")
  inStock     Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())

  /// Listings are always "in stock first, newest first".
  @@index([inStock, createdAt])
  @@map("products")
}
