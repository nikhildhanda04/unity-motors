# ---- Admin login (/admin) ----
ADMIN_PHONE=9215593793          # 10 digits; +91 / spaces are stripped on login
ADMIN_PASSWORD=change-me        # what staff type. CHANGE THIS.
ADMIN_TOKEN=                    # session cookie value: openssl rand -hex 32

# ---- Car rows (Neon Postgres via Prisma) ----
# Use the POOLED Neon connection string (the host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ---- Media (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=            # the short cloud name, e.g. z4rdrptw (NOT your account title)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=          # server-only. never prefix this NEXT_PUBLIC_

# ---- WhatsApp enquiry ----
